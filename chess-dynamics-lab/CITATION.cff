title: >-
  Chess Particle Dynamics: A Certifiable Laboratory (the
  chess-dynamics-lab program)
authors:
  - name: Isaev, Iskhak Khamzatovich
    alias: Исаев Исхак Хамзатович
    orcid: "https://orcid.org/0009-0003-7299-0701"
version: 2.2.0
date-released: '2026-10-01'
