title: >-
  The Dynamic Principle: A Unified Monograph and Computational
  Laboratory
authors:
  - name: Isaev, Iskhak Khamzatovich
    alias: Исаев Исхак Хамзатович
    orcid: "https://orcid.org/0009-0003-7299-0701"
version: 1.1.2
